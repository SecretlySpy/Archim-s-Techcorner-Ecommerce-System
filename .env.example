# ---------------------------------------------------------------------------
# Archim's TechCorner — local development environment (EXAMPLE — copy to .env)
# Never commit a real .env. Production secrets come from the secrets manager.
# ---------------------------------------------------------------------------

# --- MySQL (source of truth) ---
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_DATABASE=archims_techcorner
# Application runtime user (DML only, no DDL) — see mysql-design §14
MARKETPLACE_DB_USER=marketplace_app
MARKETPLACE_DB_PASSWORD=app_dev_only
# Flyway migration user (DDL) — separate identity
FLYWAY_DB_USER=marketplace_flyway
FLYWAY_DB_PASSWORD=flyway_dev_only

# --- Spring Boot marketplace-api ---
MARKETPLACE_DB_URL=jdbc:mysql://mysql:3306/archims_techcorner?useSSL=false&serverTimezone=UTC&characterEncoding=utf8
SPRING_PROFILES_ACTIVE=local

# --- Auth secrets (dev-only; rotate + externalize in prod) ---
# HS256 signing key for access-token JWTs — MUST be >= 32 bytes. Generate a real one for staging/prod.
AUTH_JWT_SECRET=change_me_dev_only_min_32_bytes_long_secret_value
AUTH_ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600     # 14 days
AUTH_COOKIE_SECURE=false                    # true behind HTTPS
AUTH_COOKIE_DOMAIN=localhost

# --- Redis (temporary/accelerator only) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Mail sandbox (MailHog) ---
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@archimstechcorner.local

# --- Web apps ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
